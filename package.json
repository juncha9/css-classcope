{
    "name": "style-compass",
    "displayName": "Style Compass",
    "description": "Highlights the corresponding CSS/SCSS module class when your cursor is on a TSX element with a CSS module className",
    "version": "0.0.1",
    "publisher": "alkemic-studio",
    "engines": {
        "vscode": "^1.109.0"
    },
    "categories": [
        "Other"
    ],
    "activationEvents": [
        "onLanguage:typescriptreact"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "configuration": {
            "title": "Style Compass",
            "properties": {
                "styleCompass.highlightColor": {
                    "type": "string",
                    "default": "rgba(255, 200, 0, 0.3)",
                    "description": "Background color for CSS class highlight"
                }
            }
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run compile",
        "compile": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "vscode-test"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/vscode": "^1.109.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2",
        "typescript": "^5.9.3"
    }
}
