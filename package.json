{
    "name": "css-classcope",
    "displayName": "CSS Classcope",
    "description": "Bidirectionally highlights matching CSS Module classes between TSX and CSS/SCSS files",
    "version": "0.1.0",
    "publisher": "alkemic-studio",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/juncha9/css-classcope"
    },
    "icon": "icon.png",
    "engines": {
        "vscode": "^1.109.0"
    },
    "categories": [
        "Programming Languages",
        "Visualization",
        "Other"
    ],
    "keywords": [
        "css",
        "css modules",
        "scss",
        "tsx",
        "react",
        "highlight"
    ],
    "activationEvents": [
        "onLanguage:typescriptreact",
        "onLanguage:javascriptreact",
        "onLanguage:css",
        "onLanguage:scss"
    ],
    "main": "./dist/extension.js",
    "contributes": {
        "configuration": {
            "title": "CSS Classcope",
            "properties": {
                "cssClasscope.highlightColor": {
                    "type": "string",
                    "default": "rgba(255, 200, 0, 0.3)",
                    "description": "Highlight color (used for background, outline, and overview ruler)"
                }
            }
        }
    },
    "scripts": {
        "build": "tsc -p ./",
        "watch": "tsc -watch -p ./",
        "test": "vscode-test",
        "package": "npx @vscode/vsce package",
        "publish": "npx @vscode/vsce publish"
    },
    "dependencies": {
        "typescript": "^5.9.3"
    },
    "devDependencies": {
        "@types/node": "^22.19.17",
        "@types/vscode": "^1.109.0",
        "@vscode/test-cli": "^0.0.12",
        "@vscode/test-electron": "^2.5.2"
    }
}
